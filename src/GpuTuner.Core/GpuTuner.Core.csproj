<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Product>ROCH GPU</Product>
    <Version>1.0.0</Version>
    <InformationalVersion>1.0.0</InformationalVersion>
    <Copyright>Copyright (c) 2026</Copyright>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>GpuTuner.Core</RootNamespace>
    <!-- Symbols inside the exe rather than beside it: one file to ship, and the crash log
         still names a line. -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\third_party\NvAPIWrapper\NvAPIWrapper.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The vendor-private layout constants (NvApiPrivate) are internal on purpose, but they encode
         hard-won facts about the driver's struct layout that are worth pinning down in tests. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>GpuTuner.Core.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
