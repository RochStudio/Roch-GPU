<Window x:Class="GpuTuner.App.CurveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:GpuTuner.App.Controls"
        Title="Voltage / Frequency curve" Height="620" Width="960" MinHeight="460" MinWidth="700"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource {x:Type Window}}">
    <DockPanel Margin="12">

        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Panel}" Padding="12,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Flatten above" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="FlattenBox" Width="60" Text="1000" HorizontalContentAlignment="Right"
                             c:ValueBoxBehavior.SelectOnFocus="True"/>
                    <TextBlock Text="mV" VerticalAlignment="Center" Margin="4,0,8,0" Style="{StaticResource Muted}"/>
                    <Button Content="Apply flatten" Click="Flatten_Click" Padding="10,4"
                            ToolTip="Clamp every point above this voltage to the frequency at that point — the classic undervolt"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Reload from GPU" Click="Reload_Click" Margin="0,0,6,0"/>
                    <Button Content="Reset to stock" Click="ResetStock_Click" Style="{StaticResource DangerButton}" Margin="0,0,6,0"/>
                    <Button Content="Apply to GPU" Click="ApplyCurve_Click" Style="{StaticResource PrimaryButton}" Padding="14,4"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Panel}" Padding="10,6" Margin="0,10,0,0">
            <TextBlock x:Name="StatusText" Text="Drag a point to change its clock. Ctrl+drag flattens everything to the right (undervolt). Shift+drag moves the whole tail. Double-click a point to reset it, right-click anywhere to reset all."
                       Style="{StaticResource Muted}" TextWrapping="Wrap"/>
        </Border>

        <Border Style="{StaticResource Panel}" Padding="10">
            <c:VfCurveEditor x:Name="Editor"/>
        </Border>
    </DockPanel>
</Window>
