<Window x:Class="GpuTuner.App.GraphicsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Roch GPU — Graphics" Width="620" Height="510"
        MinWidth="560" MinHeight="480" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        Style="{StaticResource {x:Type Window}}">
    <Window.Resources>
        <Style x:Key="InfoName" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,3"/>
        </Style>
        <Style x:Key="InfoValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource BrandBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,3"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>
    <Grid Margin="14,12,14,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="4,0,4,10">
            <StackPanel>
                <TextBlock Text="Graphics" FontSize="22" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"/>
                <TextBlock Text="Static hardware and driver information"
                           Style="{StaticResource Muted}" Margin="0,3,0,0"/>
            </StackPanel>
            <Border HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="5"
                    Background="{DynamicResource PanelBrush}" Padding="10,6">
                <TextBlock Text="READ ONLY" FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource MutedBrush}"/>
            </Border>
        </Grid>

        <Border Grid.Row="1" Background="Transparent" Margin="0,0,0,3">
            <TextBlock Text="GRAPHICS" Foreground="{DynamicResource BrandBrush}"
                       FontWeight="SemiBold" Margin="8,4"/>
        </Border>

        <ItemsControl Grid.Row="2" ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="RowBand" Background="Transparent">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" Style="{StaticResource InfoName}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Value}"
                                       Style="{StaticResource InfoValue}"/>
                        </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsBanded}" Value="True">
                            <Setter TargetName="RowBand" Property="Background"
                                    Value="{DynamicResource HighlightBrush}"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
