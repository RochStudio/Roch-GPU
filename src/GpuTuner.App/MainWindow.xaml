<Window x:Class="GpuTuner.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:GpuTuner.App.Converters"
        Title="Roch GPU" Height="668" Width="350"
        ResizeMode="CanMinimize" WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource {x:Type Window}}">
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToBrushConverter x:Key="StatusBrush" TrueBrush="{StaticResource DangerBrush}" FalseBrush="{StaticResource MutedBrush}"/>
        <conv:BoolToBrushConverter x:Key="LimitBrush" TrueBrush="{StaticResource WarnBrush}" FalseBrush="{StaticResource MutedBrush}"/>

        <!-- Afterburner-style numbered profile slot. Dim when empty, white when stored, red when active. -->
        <Style x:Key="SlotButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Occupied}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AccentDimBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="Foreground" Value="#FFFFFFFF"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Save is a two-step arm: press it, then a number. Checked = armed (red). -->
        <Style x:Key="SaveToggle" TargetType="ToggleButton">
            <Setter Property="Background" Value="{StaticResource PanelAltBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="#FFFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Arrow either side of a slider: hold to repeat, so a value can be dialled in exactly. -->
        <!-- Title-bar buttons. The OS chrome is gone (WindowStyle=None) because Windows only ever
             greys a maximize button out, it never removes it. -->
        <Style x:Key="TitleButton" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource PanelAltBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TitleCloseButton" TargetType="Button" BasedOn="{StaticResource TitleButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
                    <Setter Property="Foreground" Value="#FFFFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom title bar: drag to move, minimise and close only. -->
        <Border Background="{StaticResource BgBrush}" MouseLeftButtonDown="TitleBar_MouseDown">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="Roch" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="GPU" FontSize="12.5" FontWeight="Bold" Margin="4,0,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource TitleButton}" Content="&#xE921;" Click="TitleMinimize_Click"
                            ToolTip="Minimise"/>
                    <Button Style="{StaticResource TitleCloseButton}" Content="&#xE8BB;" Click="TitleClose_Click"
                            ToolTip="Close"/>
                </StackPanel>
            </Grid>
        </Border>

        <DockPanel Grid.Row="1" Margin="8">

        <!-- ================= Status bar (bottom) ================= -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Panel}" Padding="9,5" Margin="0,6,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding Status}" Foreground="{Binding StatusIsError, Converter={StaticResource StatusBrush}}"
                           TextWrapping="Wrap" MaxHeight="32" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Status}"/>
                <TextBlock Grid.Row="1" Text="{Binding AppliedSummary}" Style="{StaticResource Muted}"
                           TextWrapping="Wrap" MaxHeight="48" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"
                           ToolTip="{Binding AppliedSummary}"/>
            </Grid>
        </Border>

        <!-- ================= Controls. The hardware monitor is its own window. ============ -->
            <!-- Fixed-height window: rows 0-2 size to content, row 3 is an elastic gap that soaks up the
                 slack, and the profile bar sits pinned at the bottom. Nothing scrolls. -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                    <!-- GPU header -->
                    <Border Grid.Row="0" Style="{StaticResource Panel}" Padding="10,7">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button x:Name="MonitorToggle" Content="Monitor" Click="ToggleMonitor_Click"
                                            Padding="7,2" FontSize="11" Margin="0,0,4,0" ToolTip="Open the hardware monitor in its own window"/>
                                    <!-- No Tray button: the title bar's minimise already goes to the tray, via the
                                         StateChanged handler in MainWindow.xaml.cs. -->
                                    <Button Content="Log" Click="OpenLog_Click" Padding="7,2" FontSize="11"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding Device.Name}" FontSize="14.5" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding DeviceLine}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding LimitReasonText}" Foreground="{Binding LimitIsActive, Converter={StaticResource LimitBrush}}"
                                       FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Sliders, Afterburner order -->
                    <Border Grid.Row="1" Style="{StaticResource Panel}" Margin="0,4,0,0" Padding="10,10">
                        <StackPanel>

                            <!-- V/F curve editor, above the sliders it belongs to (Afterburner Ctrl+F) -->
                            <Button Content="V/F Curve" Click="CurveEditor_Click" Padding="10,4" Margin="0,0,0,7"
                                    HorizontalAlignment="Stretch" FontWeight="SemiBold"
                                    Visibility="{Binding HasCurveEditor, Converter={StaticResource BoolToVis}}"
                                    ToolTip="Open the voltage/frequency curve (Afterburner Ctrl+F equivalent)"/>

                            <!-- The levers that can brown a card out live behind their own gate, off
                                 by default, rather than sitting in the main column where a stray drag
                                 reaches them. -->
                            <Button Content="XOC" Click="Xoc_Click" Padding="10,4" Margin="0,0,0,7"
                                    HorizontalAlignment="Stretch" FontWeight="SemiBold"
                                    Visibility="{Binding HasXoc, Converter={StaticResource BoolToVis}}"
                                    ToolTip="Extreme OC: rail ranges, the crossbar, SYS and video clocks, and the clock range"/>

                            <!-- 1a. Over-voltage percentage (Afterburner's "Core Voltage (%)"). Raises the
                                 ceiling above the top of the V/F table; separate lever from the cap below. -->
                            <StackPanel Visibility="{Binding HasVoltageBoost, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Voltage Boost (%)" Style="{StaticResource RowLabel}"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource ValueBox}"
                                             ToolTip="{Binding VoltageBoostRangeText}"
                                             Text="{Binding VoltageBoostInput, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                                </Grid>
                                <Grid Margin="0,1,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <RepeatButton Style="{StaticResource Nudge}" Content="&#9664;" Margin="0,0,4,0"
                                                  Command="{Binding NudgeCommand}" CommandParameter="voltboost:-1"/>
                                    <Slider Grid.Column="1" Style="{StaticResource Tight}" Minimum="{Binding Caps.VoltageBoostMinPercent}" Maximum="{Binding Caps.VoltageBoostMaxPercent}"
                                            Value="{Binding VoltageBoost, Mode=TwoWay}" TickFrequency="5"
                                            SmallChange="5" LargeChange="5"/>
                                    <RepeatButton Grid.Column="2" Style="{StaticResource Nudge}" Content="&#9654;" Margin="4,0,0,0"
                                                  Command="{Binding NudgeCommand}" CommandParameter="voltboost:1"/>
                                </Grid>
                            </StackPanel>

                            <!-- 1c. Core voltage as a signed offset (AMD: applied to the whole curve).
                                 Belongs here, not in the XOC window: this is the everyday undervolt
                                 lever on AMD, and XOC is hidden unless a rail or the crossbar is
                                 available - neither of which RDNA offers, so it was unreachable. -->
                            <StackPanel Visibility="{Binding IsVoltageOffset, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Voltage Offset (mV)" Style="{StaticResource RowLabel}"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource ValueBox}"
                                             ToolTip="{Binding VoltageOffsetRangeText}"
                                             Text="{Binding VoltageOffsetInput, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                                </Grid>
                                <Grid Margin="0,1,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <RepeatButton Style="{StaticResource Nudge}" Content="&#9664;" Margin="0,0,4,0"
                                                  Command="{Binding NudgeCommand}" CommandParameter="voltoffset:-1"/>
                                    <Slider Grid.Column="1" Style="{StaticResource Tight}" Minimum="{Binding Caps.VoltageOffsetMinMv}" Maximum="{Binding Caps.VoltageOffsetMaxMv}"
                                            Value="{Binding VoltageOffset, Mode=TwoWay}" TickFrequency="5"
                                            SmallChange="5" LargeChange="5"/>
                                    <RepeatButton Grid.Column="2" Style="{StaticResource Nudge}" Content="&#9654;" Margin="4,0,0,0"
                                                  Command="{Binding NudgeCommand}" CommandParameter="voltoffset:1"/>
                                </Grid>
                                <TextBlock Text="Undervolt: 0 is stock, more negative drops the whole curve."
                                           Style="{StaticResource Muted}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <!-- 2. Core clock -->
                            <Grid Margin="0,14,0,0" IsEnabled="{Binding Caps.CanSetCoreOffset}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Core Clock (MHz)" Style="{StaticResource RowLabel}"/>
                                <TextBox Grid.Column="1" Style="{StaticResource ValueBox}"
                                         ToolTip="{Binding CoreRangeText}"
                                         Text="{Binding CoreOffsetInput, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                            </Grid>
                            <Grid Margin="0,1,0,0" IsEnabled="{Binding Caps.CanSetCoreOffset}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <RepeatButton Style="{StaticResource Nudge}" Content="&#9664;" Margin="0,0,4,0"
                                              Command="{Binding NudgeCommand}" CommandParameter="core:-1"/>
                                <Slider Grid.Column="1" Style="{StaticResource Tight}" Minimum="{Binding Caps.CoreOffsetMinMhz}" Maximum="{Binding Caps.CoreOffsetMaxMhz}"
                                    Value="{Binding CoreOffset, Mode=TwoWay}" TickFrequency="15"
                                    SmallChange="15" LargeChange="15" IsEnabled="{Binding Caps.CanSetCoreOffset}"/>
                                <RepeatButton Grid.Column="2" Style="{StaticResource Nudge}" Content="&#9654;" Margin="4,0,0,0"
                                              Command="{Binding NudgeCommand}" CommandParameter="core:1"/>
                            </Grid>

                            <!-- 3. Memory clock -->
                            <Grid Margin="0,14,0,0" IsEnabled="{Binding Caps.CanSetMemoryOffset}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding MemoryLabel}" Style="{StaticResource RowLabel}"/>
                                <TextBox Grid.Column="1" Style="{StaticResource ValueBox}"
                                         ToolTip="{Binding MemRangeText}"
                                         Text="{Binding MemoryOffsetInput, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                            </Grid>
                            <Grid Margin="0,1,0,0" IsEnabled="{Binding Caps.CanSetMemoryOffset}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <RepeatButton Style="{StaticResource Nudge}" Content="&#9664;" Margin="0,0,4,0"
                                              Command="{Binding NudgeCommand}" CommandParameter="mem:-1"/>
                                <Slider Grid.Column="1" Style="{StaticResource Tight}" Minimum="{Binding Caps.MemoryOffsetMinMhz}" Maximum="{Binding Caps.MemoryOffsetMaxMhz}"
                                    Value="{Binding MemoryOffset, Mode=TwoWay}" TickFrequency="{Binding MemoryStepMhz}"
                                    SmallChange="{Binding MemoryStepMhz}" LargeChange="{Binding MemoryStepMhz}"
                                    IsEnabled="{Binding Caps.CanSetMemoryOffset}"/>
                                <RepeatButton Grid.Column="2" Style="{StaticResource Nudge}" Content="&#9654;" Margin="4,0,0,0"
                                              Command="{Binding NudgeCommand}" CommandParameter="mem:1"/>
                            </Grid>

                            <!-- 4. Power limit -->
                            <Grid Margin="0,14,0,0" IsEnabled="{Binding Caps.CanSetPowerLimit}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding PowerLabel}" Style="{StaticResource RowLabel}"/>
                                <TextBox Grid.Column="1" Style="{StaticResource ValueBox}"
                                         ToolTip="{Binding PowerRangeText}"
                                         Text="{Binding PowerLimitInput, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                            </Grid>
                            <Grid Margin="0,1,0,0" IsEnabled="{Binding Caps.CanSetPowerLimit}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <RepeatButton Style="{StaticResource Nudge}" Content="&#9664;" Margin="0,0,4,0"
                                              Command="{Binding NudgeCommand}" CommandParameter="power:-1"/>
                                <Slider Grid.Column="1" Style="{StaticResource Tight}" Minimum="{Binding Caps.PowerLimitMinPercent}" Maximum="{Binding Caps.PowerLimitMaxPercent}"
                                    Value="{Binding PowerLimit, Mode=TwoWay}" IsEnabled="{Binding Caps.CanSetPowerLimit}"/>
                                <RepeatButton Grid.Column="2" Style="{StaticResource Nudge}" Content="&#9654;" Margin="4,0,0,0"
                                              Command="{Binding NudgeCommand}" CommandParameter="power:1"/>
                            </Grid>

                            <!-- 5. Temperature limit — hidden on cards where the driver owns it (RDNA 4) -->
                            <StackPanel Visibility="{Binding HasTempLimit, Converter={StaticResource BoolToVis}}">
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Temperature Limit (°C)" Style="{StaticResource RowLabel}"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource ValueBox}"
                                             ToolTip="{Binding TempRangeText}"
                                             Text="{Binding TempLimitInput, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                                </Grid>
                                <Grid Margin="0,1,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <RepeatButton Style="{StaticResource Nudge}" Content="&#9664;" Margin="0,0,4,0"
                                              Command="{Binding NudgeCommand}" CommandParameter="temp:-1"/>
                                <Slider Grid.Column="1" Style="{StaticResource Tight}" Minimum="{Binding Caps.TempLimitMinC}" Maximum="{Binding Caps.TempLimitMaxC}"
                                        Value="{Binding TempLimit, Mode=TwoWay}"/>
                                <RepeatButton Grid.Column="2" Style="{StaticResource Nudge}" Content="&#9654;" Margin="4,0,0,0"
                                              Command="{Binding NudgeCommand}" CommandParameter="temp:1"/>
                            </Grid>
                            </StackPanel>

                            <!-- 5b. AMD-only: memory timing preset and zero RPM -->
                            <Grid Margin="0,14,0,0" Visibility="{Binding HasMemoryTiming, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Memory Timing" Style="{StaticResource RowLabel}"/>
                                <ComboBox Grid.Column="1" Width="118" FontSize="12"
                                          ItemsSource="{Binding MemoryTimingOptions}"
                                          SelectedIndex="{Binding MemoryTimingIndex, Mode=TwoWay}"
                                          ToolTip="Faster memory timings at the same clock. Can cause instability — test it."/>
                            </Grid>
                            <CheckBox Margin="0,14,0,0" Content="Zero RPM (fans stop at idle)"
                                      FontSize="12" FontWeight="SemiBold"
                                      IsChecked="{Binding ZeroRpm, Mode=TwoWay}"
                                      Visibility="{Binding HasZeroRpm, Converter={StaticResource BoolToVis}}"/>

                            <!-- 6. Fan speed -->
                            <Grid Margin="0,14,0,0" IsEnabled="{Binding Caps.CanSetFanSpeed}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Fan Speed (%)" Style="{StaticResource RowLabel}"/>
                                <ComboBox Grid.Column="1" Width="92" Margin="0,0,6,0" SelectedIndex="{Binding FanModeIndex, Mode=TwoWay}" FontSize="12">
                                    <ComboBoxItem Content="Auto"/>
                                    <ComboBoxItem Content="Fixed"/>
                                    <ComboBoxItem Content="Curve"/>
                                </ComboBox>
                                <TextBox Grid.Column="2" Style="{StaticResource ValueBox}"
                                         IsEnabled="{Binding IsFixedFan}"
                                         Text="{Binding FixedFanInput, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                            </Grid>
                            <Grid Margin="0,1,0,0" IsEnabled="{Binding IsFixedFan}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <RepeatButton Style="{StaticResource Nudge}" Content="&#9664;" Margin="0,0,4,0"
                                              Command="{Binding NudgeCommand}" CommandParameter="fan:-1"/>
                                <Slider Grid.Column="1" Style="{StaticResource Tight}" Minimum="{Binding Caps.FanMinPercent}" Maximum="{Binding Caps.FanMaxPercent}"
                                    Value="{Binding FixedFan, Mode=TwoWay}" TickFrequency="5" IsEnabled="{Binding IsFixedFan}"/>
                                <RepeatButton Grid.Column="2" Style="{StaticResource Nudge}" Content="&#9654;" Margin="4,0,0,0"
                                              Command="{Binding NudgeCommand}" CommandParameter="fan:1"/>
                            </Grid>
                            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                                       Visibility="{Binding IsCurveFan, Converter={StaticResource BoolToVis}}"
                                       Text="Curve: edit it in the panel on the right (drag points, double-click to add, right-click to remove)."/>
                        </StackPanel>
                    </Border>

                    <!-- Apply / Reset -->
                    <Border Grid.Row="2" Style="{StaticResource Panel}" Margin="0,6,0,0" Padding="10,6">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Content="Apply" Style="{StaticResource PrimaryButton}" Command="{Binding ApplyCommand}" Height="30" FontSize="12.5"/>
                                <Button Grid.Column="2" Content="Revert" Command="{Binding RevertCommand}" ToolTip="Sliders back to the applied values"/>
                                <Button Grid.Column="4" Content="Reset" Style="{StaticResource DangerButton}" Command="{Binding ResetCommand}" ToolTip="Driver defaults (also clears the voltage curve)"/>
                            </Grid>
                            <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" Text="Unapplied changes" Foreground="{StaticResource WarnBrush}"
                                       Visibility="{Binding PendingChanges, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </Border>

                    <!-- Profile bar: label, five numbered slots, Save. Click a number to load + apply it;
                         press Save first to store the current settings into that number instead. -->
                    <Border Grid.Row="4" Style="{StaticResource Panel}" Margin="0,6,0,0" Padding="10,7">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="PROFILE" Style="{StaticResource SectionTitle}" Margin="0,0,9,0" VerticalAlignment="Center"/>

                                <ItemsControl x:Name="SlotBar" Grid.Column="1" ItemsSource="{Binding Slots}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource SlotButton}" Content="{Binding Label}" ToolTip="{Binding Tip}"
                                                    Command="{Binding DataContext.SlotCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding Number}"
                                                    MouseRightButtonUp="Slot_RightClick"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ToggleButton Grid.Column="2" Style="{StaticResource SaveToggle}" Content="Save"
                                              IsChecked="{Binding SaveArmed, Mode=TwoWay}"
                                              ToolTip="Press Save, then a number, to store the current settings in that slot"/>
                            </Grid>

                            <TextBlock Style="{StaticResource Muted}" Margin="0,5,0,0" Foreground="{StaticResource WarnBrush}"
                                       Text="Pick a slot to save into (press Save again to cancel)"
                                       Visibility="{Binding SaveArmed, Converter={StaticResource BoolToVis}}"/>

                            <Grid Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Content="Startup" IsChecked="{Binding ApplyOnStartup, Mode=TwoWay}" FontSize="11.5"
                                          VerticalAlignment="Center" Margin="0,0,6,0"
                                          ToolTip="Apply this profile automatically at Windows logon"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding Profiles}" SelectedItem="{Binding StartupProfile, Mode=TwoWay}"
                                          FontSize="11.5" MinHeight="22"/>
                            </Grid>
                        </StackPanel>
                    </Border>

            </Grid>
        </DockPanel>
    </Grid>
</Window>
