<Window x:Class="GpuTuner.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:GpuTuner.App.Converters"
        Title="Roch GPU" SizeToContent="Height" MinHeight="640" Width="660"
        ResizeMode="CanMinimize" WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource {x:Type Window}}">
    <Window.Resources>
        <Style x:Key="HeaderButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="64"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SectionBorderBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="frame" Property="BorderBrush" Value="{DynamicResource BrandHoverBrush}"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="frame" Property="Background" Value="{DynamicResource HeaderBrush}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LayoutSlider" TargetType="Slider" BasedOn="{StaticResource Tight}">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                   Value="{TemplateBinding Value}" IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border x:Name="track" Background="{DynamicResource AccentBrush}" Height="4" VerticalAlignment="Center"/><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter TargetName="track" Property="Background" Value="{DynamicResource MutedBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="12" Height="24">
                                        <Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="thumb" Background="{DynamicResource TextBrush}" BorderBrush="{DynamicResource TextBrush}" BorderThickness="1" CornerRadius="1"/><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter TargetName="thumb" Property="Background" Value="{DynamicResource MutedBrush}"/><Setter TargetName="thumb" Property="BorderBrush" Value="{DynamicResource MutedBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="{DynamicResource BorderBrush}" Height="4" VerticalAlignment="Center"/></ControlTemplate></RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LayoutPanel" TargetType="Border" BasedOn="{StaticResource Panel}">
            <Setter Property="BorderBrush" Value="{DynamicResource SectionBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="2"/>
        </Style>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToBrushConverter x:Key="StatusBrush" TrueKey="DangerBrush" FalseKey="TextBrush"/>
        <conv:InformationLinePartConverter x:Key="InfoLinePart"/>
        <conv:BoolToBrushConverter x:Key="LimitBrush" TrueKey="WarnBrush" FalseKey="TextBrush"/>

        <!-- Afterburner-style numbered profile slot. Dim when empty, white when stored, red when active. -->
        <Style x:Key="SlotButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Occupied}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectedBrush}"/>
                    <Setter Property="Foreground" Value="#FFFFFFFF"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource SelectedBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Save is a two-step arm: press it, then a number. Checked = armed (red). -->
        <Style x:Key="SaveToggle" TargetType="ToggleButton">
            <Setter Property="Background" Value="{DynamicResource PanelAltBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource BrandHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="{DynamicResource SelectedBrush}"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource SelectedBrush}"/>
                                <Setter Property="Foreground" Value="#FFFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource BgBrush}"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Arrow either side of a slider: hold to repeat, so a value can be dialled in exactly. -->
        <!-- Title-bar buttons. The OS chrome is gone (WindowStyle=None) because Windows only ever
             greys a maximize button out, it never removes it. -->
        <Style x:Key="TitleButton" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource TitleHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TitleCloseButton" TargetType="Button" BasedOn="{StaticResource TitleButton}">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource CloseHoverBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CloseHoverBrush}"/>
                    <Setter Property="Foreground" Value="#FFFFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FooterLink" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource BrandBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource BrandHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Shared Viewer title strip: 30px high, a 24px dragon and 12px name/version. -->
        <Border Height="30" Background="{DynamicResource BgBrush}" MouseLeftButtonDown="TitleBar_MouseDown">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <Image Source="pack://application:,,,/icon.png" Width="24" Height="24"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="{Binding TitleText}" FontSize="12" FontWeight="Bold" Margin="6,0,10,0"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="ThemeButton" Style="{StaticResource TitleButton}"
                            Width="36"
                            FontFamily="Segoe UI Symbol" FontSize="18"
                            Click="Theme_Click" ToolTip="Switch to dark mode"
                            AutomationProperties.Name="Switch to dark mode">
                        <Canvas Width="18" Height="18">
                            <Path Data="M14.125,1.323927 A8,8 0 1 0 14.125,16.676073 A8,8 0 0 1 14.125,1.323927 Z" Fill="Black"/>
                        </Canvas>
                    </Button>
                    <Button Style="{StaticResource TitleButton}" Content="&#x2212;" Click="TitleMinimize_Click"
                            ToolTip="Minimise"/>
                    <Button Style="{StaticResource TitleCloseButton}" Content="&#x00D7;" Click="TitleClose_Click"
                            ToolTip="Close"/>
                </StackPanel>
            </Grid>
        </Border>

        <DockPanel Grid.Row="1" Margin="8">

        <!-- Existing apply details remain above the shared 24px footer. Errors retain a wrapping
             message in addition to the footer status and its complete tooltip. -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource DangerBrush}"
                       TextWrapping="Wrap" MaxHeight="32" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Status}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding AppliedSummary}" Style="{StaticResource Muted}"
                       TextWrapping="Wrap" MaxHeight="48" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding AppliedSummary}"/>
            <Border Height="24" Background="{DynamicResource BgBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="YouTube" Tag="https://www.youtube.com/@MateoPcTech"
                                   Style="{StaticResource FooterLink}" MouseLeftButtonUp="XLink_Click"/>
                        <TextBlock Text=" | "/>
                        <TextBlock x:Name="XLink" Text="X" Tag="https://x.com/MateoPCTech"
                                   Style="{StaticResource FooterLink}" MouseLeftButtonUp="XLink_Click"
                                   ToolTip="https://x.com/MateoPCTech"/>
                        <TextBlock Text=" | "/>
                        <TextBlock Text="Discord" Tag="https://discord.gg/KfzExpKQHB"
                                   Style="{StaticResource FooterLink}" MouseLeftButtonUp="XLink_Click"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding Status}"
                               Foreground="{Binding StatusIsError, Converter={StaticResource StatusBrush}}"
                               Margin="12,0,0,0" VerticalAlignment="Center" TextAlignment="Right"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}"/>
                </Grid>
            </Border>
        </StackPanel>

        <!-- ================= Controls. The hardware monitor is its own window. ============ -->
            <!-- Fixed-height window: rows 0-2 size to content, row 3 is an elastic gap that soaks up the
                 slack, and the profile bar sits pinned at the bottom. Nothing scrolls. -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                    <!-- GPU header -->
                    <Border Grid.Row="0" Style="{StaticResource Panel}" Padding="6,0,6,7">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,2,8,0">
                                    <TextBlock Text="{Binding DeviceDisplayName}" FontSize="12" FontWeight="Bold" TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}"/>
                                    <TextBlock Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"><Run Text="{Binding DriverLine, Converter={StaticResource InfoLinePart}, ConverterParameter=Label, Mode=OneWay}"/><Run Text="{Binding DriverLine, Converter={StaticResource InfoLinePart}, ConverterParameter=Value, Mode=OneWay}" Foreground="{DynamicResource AccentBrush}"/></TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="Graphics" Click="Graphics_Click"
                                            Style="{StaticResource HeaderButton}" Width="80"
                                            ToolTip="Open static graphics-card and driver information"/>
                                    <Button x:Name="MonitorToggle" Content="Telemetry" Click="ToggleMonitor_Click"
                                            Style="{StaticResource HeaderButton}" Width="80" ToolTip="Open the hardware monitor in its own window"/>
                                    <!-- No Tray button: the title bar's minimise already goes to the tray, via the
                                         StateChanged handler in MainWindow.xaml.cs. -->
                                    <Button Content="Log" Click="OpenLog_Click" Style="{StaticResource HeaderButton}"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"><Run Text="{Binding BiosLine, Converter={StaticResource InfoLinePart}, ConverterParameter=Label, Mode=OneWay}"/><Run Text="{Binding BiosLine, Converter={StaticResource InfoLinePart}, ConverterParameter=Value, Mode=OneWay}" Foreground="{DynamicResource AccentBrush}"/></TextBlock>
                            <TextBlock Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"><Run Text="{Binding PcieBusLine, Converter={StaticResource InfoLinePart}, ConverterParameter=Label, Mode=OneWay}"/><Run Text="{Binding PcieBusLine, Converter={StaticResource InfoLinePart}, ConverterParameter=Value, Mode=OneWay}" Foreground="{DynamicResource AccentBrush}"/></TextBlock>
                            <TextBlock Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"><Run Text="{Binding ResizableBarLine, Converter={StaticResource InfoLinePart}, ConverterParameter=Label, Mode=OneWay}"/><Run Text="{Binding ResizableBarLine, Converter={StaticResource InfoLinePart}, ConverterParameter=Value, Mode=OneWay}" Foreground="{DynamicResource AccentBrush}"/></TextBlock>
                            <TextBlock Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"><Run Text="{Binding MemoryTypeLine, Converter={StaticResource InfoLinePart}, ConverterParameter=Label, Mode=OneWay}"/><Run Text="{Binding MemoryTypeLine, Converter={StaticResource InfoLinePart}, ConverterParameter=Value, Mode=OneWay}" Foreground="{DynamicResource AccentBrush}"/></TextBlock>
                            <TextBlock Text="{Binding LimitReasonText}" Foreground="{Binding LimitIsActive, Converter={StaticResource LimitBrush}}"
                                       FontSize="12" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Sliders, Afterburner order -->
                    <Border Grid.Row="1" Style="{StaticResource Panel}" Margin="0,4,0,0" Padding="10,10">
                        <StackPanel>

                            <!-- The three hardware editors share one row. Their visibility and
                                 enable rules still come from what this card actually exposes. -->
                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="V/F Curve" Click="CurveEditor_Click"
                                        Padding="10,4" HorizontalAlignment="Stretch" FontWeight="Bold"
                                        Visibility="{Binding HasCurveEditor, Converter={StaticResource BoolToVis}}"
                                        ToolTip="Open the voltage/frequency curve (Afterburner Ctrl+F equivalent)"/>
                                <!-- Rail, OCP and clock-range controls remain behind the XOC gate. -->
                                <Button Grid.Column="2" Content="XOC" Click="Xoc_Click"
                                        Padding="10,4" HorizontalAlignment="Stretch" FontWeight="Bold"
                                        Visibility="{Binding HasXoc, Converter={StaticResource BoolToVis}}"
                                        ToolTip="XOC: rail ranges, OCP current limits, and the clock range"/>
                                <Button Grid.Column="4" Content="Fan" Click="Fan_Click"
                                        Padding="10,4" HorizontalAlignment="Stretch" FontWeight="Bold"
                                        IsEnabled="{Binding Caps.CanSetFanSpeed}"
                                        ToolTip="Fan control: a duty per fan, or a curve"/>
                            </Grid>

                            <Border Style="{StaticResource LayoutPanel}" Padding="14,10" Margin="0,8,0,0"><StackPanel>
                            <!-- 1a. Over-voltage percentage (Afterburner's "Core Voltage (%)"). Raises the
                                 ceiling above the top of the V/F table; separate lever from the cap below. -->
                            <StackPanel Visibility="{Binding HasVoltageBoost, Converter={StaticResource BoolToVis}}">
                                <Grid Margin="0,12,0,12" >
 <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="88"/></Grid.ColumnDefinitions>
 <TextBlock Text="{Binding VoltageBoostLabel}" Style="{StaticResource RowLabel}" VerticalAlignment="Center" FontSize="12"/>
 <Grid Grid.Column="1" Margin="8,0,18,0" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <RepeatButton Style="{StaticResource Nudge}" Content="&#9664;" Margin="0,0,4,0"
                                                  Command="{Binding NudgeCommand}" CommandParameter="voltboost:-1"/>
                                    <Slider Grid.Column="1" Style="{StaticResource LayoutSlider}" Minimum="{Binding Caps.VoltageBoostMinPercent}" Maximum="{Binding Caps.VoltageBoostMaxPercent}"
                                            Value="{Binding VoltageBoost, Mode=TwoWay}" TickFrequency="{Binding VoltageBoostStepPercent}"
                                            SmallChange="5" LargeChange="5"/>
                                    <RepeatButton Grid.Column="2" Style="{StaticResource Nudge}" Content="&#9654;" Margin="4,0,0,0"
                                                  Command="{Binding NudgeCommand}" CommandParameter="voltboost:1"/>
                                </Grid>
 <TextBox Grid.Column="2" Style="{StaticResource ValueBox}"
                                             ToolTip="{Binding VoltageBoostRangeText}"
                                             Text="{Binding VoltageBoostInput, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Height="30" FontSize="12" VerticalContentAlignment="Center"/>
 </Grid>
                            </StackPanel>

                            <!-- 1c. Core voltage as a signed offset (AMD: applied to the whole curve).
                                 Belongs here, not in the XOC window: this is the everyday undervolt
                                 lever on AMD, and XOC is hidden unless a rail or the crossbar is
                                 available - neither of which RDNA offers, so it was unreachable. -->
                            <StackPanel Visibility="{Binding IsVoltageOffset, Converter={StaticResource BoolToVis}}">
                                <Grid Margin="0,12,0,12" >
 <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="88"/></Grid.ColumnDefinitions>
 <TextBlock Text="Voltage Offset (mV)" Style="{StaticResource RowLabel}" VerticalAlignment="Center" FontSize="12"/>
 <Grid Grid.Column="1" Margin="8,0,18,0" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <RepeatButton Style="{StaticResource Nudge}" Content="&#9664;" Margin="0,0,4,0"
                                                  Command="{Binding NudgeCommand}" CommandParameter="voltoffset:-1"/>
                                    <Slider Grid.Column="1" Style="{StaticResource LayoutSlider}" Minimum="{Binding Caps.VoltageOffsetMinMv}" Maximum="{Binding Caps.VoltageOffsetMaxMv}"
                                            Value="{Binding VoltageOffset, Mode=TwoWay}" TickFrequency="5"
                                            SmallChange="5" LargeChange="5"/>
                                    <RepeatButton Grid.Column="2" Style="{StaticResource Nudge}" Content="&#9654;" Margin="4,0,0,0"
                                                  Command="{Binding NudgeCommand}" CommandParameter="voltoffset:1"/>
                                </Grid>
 <TextBox Grid.Column="2" Style="{StaticResource ValueBox}"
                                             ToolTip="{Binding VoltageOffsetRangeText}"
                                             Text="{Binding VoltageOffsetInput, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Height="30" FontSize="12" VerticalContentAlignment="Center"/>
 </Grid>
                            </StackPanel>

                            <!-- 2. Core clock -->
                            <Grid Margin="0,12,0,12" IsEnabled="{Binding Caps.CanSetCoreOffset}">
 <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="88"/></Grid.ColumnDefinitions>
 <TextBlock Text="{Binding CoreLabel}" Style="{StaticResource RowLabel}" VerticalAlignment="Center" FontSize="12"/>
 <Grid Grid.Column="1" Margin="8,0,18,0" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <RepeatButton Style="{StaticResource Nudge}" Content="&#9664;" Margin="0,0,4,0"
                                              Command="{Binding NudgeCommand}" CommandParameter="core:-1"/>
                                <Slider Grid.Column="1" Style="{StaticResource LayoutSlider}" Minimum="{Binding Caps.CoreOffsetMinMhz}" Maximum="{Binding Caps.CoreOffsetMaxMhz}"
                                    Value="{Binding CoreOffset, Mode=TwoWay}" TickFrequency="{Binding CoreStepMhz}"
                                    SmallChange="{Binding CoreStepMhz}" LargeChange="{Binding CoreStepMhz}" IsEnabled="{Binding Caps.CanSetCoreOffset}"/>
                                <RepeatButton Grid.Column="2" Style="{StaticResource Nudge}" Content="&#9654;" Margin="4,0,0,0"
                                              Command="{Binding NudgeCommand}" CommandParameter="core:1"/>
                            </Grid>
 <TextBox Grid.Column="2" Style="{StaticResource ValueBox}"
                                         ToolTip="{Binding CoreRangeText}"
                                         Text="{Binding CoreOffsetInput, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Height="30" FontSize="12" VerticalContentAlignment="Center"/>
 </Grid>

                            <!-- XBAR, SYS and video are regular clock controls. Unlike the rail and
                                 OCP controls in XOC, they have no separate Enable/Disable gate: the
                                 value shown here is what Apply writes, and zero restores stock. -->
                            <Grid Margin="0,5,0,5" Visibility="{Binding HasXbar, Converter={StaticResource BoolToVis}}">
 <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="88"/></Grid.ColumnDefinitions>
 <TextBlock Text="XBAR Clock (MHz offset)" Style="{StaticResource RowLabel}" VerticalAlignment="Center" FontSize="12"/>
 <Grid Grid.Column="1" Margin="8,0,18,0" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <RepeatButton Style="{StaticResource Nudge}" Content="&#9664;" Margin="0,0,4,0"
                                              Command="{Binding NudgeCommand}" CommandParameter="xbar:-1"/>
                                <Slider Grid.Column="1" Style="{StaticResource LayoutSlider}" Minimum="{Binding Caps.XbarOffsetMinMhz}" Maximum="{Binding Caps.XbarOffsetMaxMhz}"
                                        Value="{Binding XbarOffset, Mode=TwoWay}" TickFrequency="15" SmallChange="15" LargeChange="15"/>
                                <RepeatButton Grid.Column="2" Style="{StaticResource Nudge}" Content="&#9654;" Margin="4,0,0,0"
                                              Command="{Binding NudgeCommand}" CommandParameter="xbar:1"/>
                            </Grid>
 <TextBox Grid.Column="2" Style="{StaticResource ValueBox}" ToolTip="{Binding XbarOffsetRangeText}"
                                  Text="{Binding XbarOffsetInput, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Height="30" FontSize="12" VerticalContentAlignment="Center"/>
 </Grid>

                            <Grid Margin="0,5,0,5" Visibility="{Binding HasSys, Converter={StaticResource BoolToVis}}">
 <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="88"/></Grid.ColumnDefinitions>
 <TextBlock Text="SYS Clock (MHz offset)" Style="{StaticResource RowLabel}" VerticalAlignment="Center" FontSize="12"/>
 <Grid Grid.Column="1" Margin="8,0,18,0" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <RepeatButton Style="{StaticResource Nudge}" Content="&#9664;" Margin="0,0,4,0"
                                              Command="{Binding NudgeCommand}" CommandParameter="sys:-1"/>
                                <Slider Grid.Column="1" Style="{StaticResource LayoutSlider}" Minimum="{Binding Caps.SysOffsetMinMhz}" Maximum="{Binding Caps.SysOffsetMaxMhz}"
                                        Value="{Binding SysOffset, Mode=TwoWay}" TickFrequency="15" SmallChange="15" LargeChange="15"/>
                                <RepeatButton Grid.Column="2" Style="{StaticResource Nudge}" Content="&#9654;" Margin="4,0,0,0"
                                              Command="{Binding NudgeCommand}" CommandParameter="sys:1"/>
                            </Grid>
 <TextBox Grid.Column="2" Style="{StaticResource ValueBox}" ToolTip="{Binding SysOffsetRangeText}"
                                  Text="{Binding SysOffsetInput, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Height="30" FontSize="12" VerticalContentAlignment="Center"/>
 </Grid>

                            <Grid Margin="0,5,0,5" Visibility="{Binding HasVideo, Converter={StaticResource BoolToVis}}">
 <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="88"/></Grid.ColumnDefinitions>
 <TextBlock Text="Video Clock (MHz offset)" Style="{StaticResource RowLabel}" VerticalAlignment="Center" FontSize="12"/>
 <Grid Grid.Column="1" Margin="8,0,18,0" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <RepeatButton Style="{StaticResource Nudge}" Content="&#9664;" Margin="0,0,4,0"
                                              Command="{Binding NudgeCommand}" CommandParameter="video:-1"/>
                                <Slider Grid.Column="1" Style="{StaticResource LayoutSlider}" Minimum="{Binding Caps.VideoOffsetMinMhz}" Maximum="{Binding Caps.VideoOffsetMaxMhz}"
                                        Value="{Binding VideoOffset, Mode=TwoWay}" TickFrequency="15" SmallChange="15" LargeChange="15"/>
                                <RepeatButton Grid.Column="2" Style="{StaticResource Nudge}" Content="&#9654;" Margin="4,0,0,0"
                                              Command="{Binding NudgeCommand}" CommandParameter="video:1"/>
                            </Grid>
 <TextBox Grid.Column="2" Style="{StaticResource ValueBox}" ToolTip="{Binding VideoOffsetRangeText}"
                                  Text="{Binding VideoOffsetInput, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Height="30" FontSize="12" VerticalContentAlignment="Center"/>
 </Grid>

                            <!-- 3. Memory clock -->
                            <Grid Margin="0,12,0,12" IsEnabled="{Binding Caps.CanSetMemoryOffset}">
 <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="88"/></Grid.ColumnDefinitions>
 <TextBlock Text="{Binding MemoryLabel}" Style="{StaticResource RowLabel}" VerticalAlignment="Center" FontSize="12"/>
 <Grid Grid.Column="1" Margin="8,0,18,0" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <RepeatButton Style="{StaticResource Nudge}" Content="&#9664;" Margin="0,0,4,0"
                                              Command="{Binding NudgeCommand}" CommandParameter="mem:-1"/>
                                <Slider Grid.Column="1" Style="{StaticResource LayoutSlider}" Minimum="{Binding Caps.MemoryOffsetMinMhz}" Maximum="{Binding Caps.MemoryOffsetMaxMhz}"
                                    Value="{Binding MemoryOffset, Mode=TwoWay}" TickFrequency="{Binding MemoryStepMhz}"
                                    SmallChange="{Binding MemoryStepMhz}" LargeChange="{Binding MemoryStepMhz}"
                                    IsEnabled="{Binding Caps.CanSetMemoryOffset}"/>
                                <RepeatButton Grid.Column="2" Style="{StaticResource Nudge}" Content="&#9654;" Margin="4,0,0,0"
                                              Command="{Binding NudgeCommand}" CommandParameter="mem:1"/>
                            </Grid>
 <TextBox Grid.Column="2" Style="{StaticResource ValueBox}"
                                         ToolTip="{Binding MemRangeText}"
                                         Text="{Binding MemoryOffsetInput, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Height="30" FontSize="12" VerticalContentAlignment="Center"/>
 </Grid>

                            <StackPanel Margin="0,8,0,8" Visibility="{Binding HasIntelClockRange, Converter={StaticResource BoolToVis}}">
                                <CheckBox Content="Core Clock Range (MHz)" IsChecked="{Binding IntelClockRangeEnabled}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0" IsEnabled="{Binding IntelClockRangeEnabled}">
                                    <TextBlock Text="Minimum" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Width="80" Style="{StaticResource ValueBox}" Text="{Binding ClockLockMinInput, UpdateSourceTrigger=LostFocus}" ToolTip="{Binding ClockLockRangeText}"/>
                                    <TextBlock Text="Maximum" VerticalAlignment="Center" Margin="16,0,8,0"/>
                                    <TextBox Width="80" Style="{StaticResource ValueBox}" Text="{Binding ClockLockMaxInput, UpdateSourceTrigger=LostFocus}" ToolTip="{Binding ClockLockRangeText}"/>
                                </StackPanel>
                                <TextBlock Text="Apply to set limits. Uncheck and Apply to restore driver defaults." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                            </StackPanel>

                            <!-- 4. Power limit -->
                            <Grid Margin="0,12,0,12" IsEnabled="{Binding Caps.CanSetPowerLimit}">
 <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="88"/></Grid.ColumnDefinitions>
 <TextBlock Text="{Binding PowerLabel}" Style="{StaticResource RowLabel}" VerticalAlignment="Center" FontSize="12"/>
 <Grid Grid.Column="1" Margin="8,0,18,0" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <RepeatButton Style="{StaticResource Nudge}" Content="&#9664;" Margin="0,0,4,0"
                                              Command="{Binding NudgeCommand}" CommandParameter="power:-1"/>
                                <Slider Grid.Column="1" Style="{StaticResource LayoutSlider}" Minimum="{Binding Caps.PowerLimitMinPercent}" Maximum="{Binding Caps.PowerLimitMaxPercent}"
                                    TickFrequency="{Binding PowerStepPercent}" SmallChange="{Binding PowerStepPercent}" LargeChange="{Binding PowerStepPercent}" Value="{Binding PowerLimit, Mode=TwoWay}" IsEnabled="{Binding Caps.CanSetPowerLimit}"/>
                                <RepeatButton Grid.Column="2" Style="{StaticResource Nudge}" Content="&#9654;" Margin="4,0,0,0"
                                              Command="{Binding NudgeCommand}" CommandParameter="power:1"/>
                            </Grid>
 <TextBox Grid.Column="2" Style="{StaticResource ValueBox}"
                                         ToolTip="{Binding PowerRangeText}"
                                         Text="{Binding PowerLimitInput, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Height="30" FontSize="12" VerticalContentAlignment="Center"/>
 </Grid>

                            <!-- 5. Temperature limit — hidden on cards where the driver owns it (RDNA 4) -->
                            <StackPanel Visibility="{Binding HasTempLimit, Converter={StaticResource BoolToVis}}">
                                <Grid Margin="0,12,0,12" >
 <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="88"/></Grid.ColumnDefinitions>
 <TextBlock Text="{Binding TempLabel}" Style="{StaticResource RowLabel}" VerticalAlignment="Center" FontSize="12"/>
 <Grid Grid.Column="1" Margin="8,0,18,0" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <RepeatButton Style="{StaticResource Nudge}" Content="&#9664;" Margin="0,0,4,0"
                                              Command="{Binding NudgeCommand}" CommandParameter="temp:-1"/>
                                <Slider Grid.Column="1" Style="{StaticResource LayoutSlider}" Minimum="{Binding Caps.TempLimitMinC}" Maximum="{Binding Caps.TempLimitMaxC}"
                                        TickFrequency="{Binding TempStep}" SmallChange="{Binding TempStep}" LargeChange="{Binding TempStep}" Value="{Binding TempLimit, Mode=TwoWay}"/>
                                <RepeatButton Grid.Column="2" Style="{StaticResource Nudge}" Content="&#9654;" Margin="4,0,0,0"
                                              Command="{Binding NudgeCommand}" CommandParameter="temp:1"/>
                            </Grid>
 <TextBox Grid.Column="2" Style="{StaticResource ValueBox}"
                                             ToolTip="{Binding TempRangeText}"
                                             Text="{Binding TempLimitInput, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Height="30" FontSize="12" VerticalContentAlignment="Center"/>
 </Grid>
                            </StackPanel>

                            <!-- 5b. AMD-only: memory timing preset and zero RPM -->
                            <Grid Margin="0,14,0,0" Visibility="{Binding HasMemoryTiming, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Memory Timing" Style="{StaticResource RowLabel}"/>
                                <ComboBox Grid.Column="1" Width="230" FontSize="12"
                                          ItemsSource="{Binding MemoryTimingOptions}"
                                          SelectedIndex="{Binding MemoryTimingIndex, Mode=TwoWay}"
                                          ToolTip="Faster memory timings at the same clock. Can cause instability — test it."/>
                            </Grid>

                            </StackPanel></Border>
                        </StackPanel>
                    </Border>

                    <!-- Apply / Reset -->
                    <Border Grid.Row="4" Style="{StaticResource Panel}" Margin="0,12,0,0" Padding="10,6">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Content="Apply" Style="{StaticResource PrimaryButton}" Command="{Binding ApplyCommand}" Height="42" FontSize="12"/>
                                <Button Grid.Column="2" Content="Reset to Defaults" Style="{StaticResource DangerButton}" Command="{Binding ResetCommand}"
                                        ToolTip="Write the driver's own defaults to the card and load them into the sliders (also clears the voltage curve)"/>
                            </Grid>
                            <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" Text="Unapplied changes" Foreground="{DynamicResource WarnBrush}"
                                       Visibility="{Binding PendingChanges, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </Border>

                    <!-- Profile bar: label, five numbered slots, Save. Click a number to load + apply it;
                         press Save first to store the current settings into that number instead. -->
                    <Border Grid.Row="2" Style="{StaticResource LayoutPanel}" Margin="10,12,10,0" Padding="14,14">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="PROFILE" Style="{StaticResource SectionTitle}" Margin="0,0,9,0" VerticalAlignment="Center"/>

                                <ItemsControl x:Name="SlotBar" Grid.Column="1" ItemsSource="{Binding Slots}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource SlotButton}" Content="{Binding Label}" ToolTip="{Binding Tip}"
                                                    Command="{Binding DataContext.SlotCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding Number}"
                                                    MouseRightButtonUp="Slot_RightClick"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ToggleButton Grid.Column="2" Style="{StaticResource SaveToggle}" Content="Save"
                                              IsChecked="{Binding SaveArmed, Mode=TwoWay}"
                                              ToolTip="Press Save, then a number, to store the current settings in that slot"/>
                            </Grid>

                            <TextBlock Style="{StaticResource Muted}" Margin="0,5,0,0" Foreground="{DynamicResource WarnBrush}"
                                       Text="Pick a slot to save into (press Save again to cancel)"
                                       Visibility="{Binding SaveArmed, Converter={StaticResource BoolToVis}}"/>

                            <Grid Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Content="Startup" IsChecked="{Binding ApplyOnStartup, Mode=TwoWay}" FontSize="12"
                                          VerticalAlignment="Center" Margin="0,0,6,0"
                                          ToolTip="Apply this profile automatically at Windows logon"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding Profiles}" SelectedItem="{Binding StartupProfile, Mode=TwoWay}"
                                          FontSize="12" MinHeight="22"/>
                            </Grid>
                        </StackPanel>
                    </Border>

            </Grid>
        </DockPanel>
    </Grid>
</Window>
