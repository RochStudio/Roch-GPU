<Window x:Class="GpuTuner.App.XocWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:GpuTuner.App.Controls"
        xmlns:conv="clr-namespace:GpuTuner.App.Converters"
        Title="XOC" SizeToContent="Height" MinHeight="600" Width="430" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource {x:Type Window}}">
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <!-- Armed drives each lever's sliders: dead while disarmed, because a slider that moves but
             is never written would be the window claiming a setting the card has not got. -->
        <conv:XocLeverConverter x:Key="Armed"/>

        <!-- One button per lever, not a pair. The pair always had exactly one half clickable, so the
             other half was only ever there to name the state - which the value box and the slider
             beside it already do. Only the label changes, which is how Roch Viewer's own light/dark
             button works: one control, naming what pressing it will do. -->
        <conv:XocGateLabelConverter x:Key="GateLabel"/>
        <Style x:Key="Gate" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Height" Value="21"/>
            <Setter Property="MinWidth" Value="64"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="12">

        <!-- Each lever is armed on its own, because they fail in unrelated ways: a rail ceiling that
             browns the card out says nothing about whether a crossbar offset is stable. Enable and
             Disable write the card straight away, the way the comparison monitor does, so this window is an action
             rather than another pending edit for the main window's Apply. -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Panel}" Padding="12,10" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="XOC" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="{Binding XocStatusText}" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- One warning for the window rather than a paragraph per lever. The old note explained the
             rails and the clock domains and had nothing to say about the OCP limits added since,
             which are the ones that need saying most: everything else here is performance, and those
             two are protection. -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Panel}" Padding="10,7" Margin="0,8,0,0">
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource WarnBrush}" FontSize="11.5">
                <Run FontWeight="Bold" Text="These can damage hardware, not just crash it."/>
                <Run Text="Nothing here is sanity-checked by the driver, and raising an OCP limit takes away the card's own protection. Arm one at a time and test between each. Nothing here survives a reboot."/>
            </TextBlock>
        </Border>

        <Border Style="{StaticResource Panel}" Padding="12,10">
            <StackPanel>

                <!-- NVVDD rail: floor and ceiling on one track -->
                <StackPanel Margin="0,2,0,6" Visibility="{Binding HasVoltageRail, Converter={StaticResource BoolToVis}}">
                    <!-- Dead while this lever is disarmed: a slider that moves but is never written
                         would be the window claiming a setting the card has not got. -->
                    <StackPanel IsEnabled="{Binding XocArmed, Converter={StaticResource Armed}, ConverterParameter=Nvvdd}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="NVVDD Range (mV)" Style="{StaticResource RowLabel}"/>
                            <TextBox Grid.Column="1" Style="{StaticResource ValueBox}" Width="46" Margin="0,0,4,0"
                                     ToolTip="{Binding VoltageRailMaxRangeText}"
                                     Text="{Binding VoltageRailFloorInput, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                            <TextBox Grid.Column="2" Style="{StaticResource ValueBox}" Width="46"
                                     ToolTip="{Binding VoltageRailMaxRangeText}"
                                     Text="{Binding VoltageRailMaxInput, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                        </Grid>
                        <c:RangeSlider Margin="0,2,0,0"
                                       Minimum="{Binding Caps.VoltageRailFloorMinMv}" Maximum="{Binding Caps.VoltageRailMaxMv}" Step="5"
                                       LowerValue="{Binding VoltageRailFloor, Mode=TwoWay}"
                                       UpperValue="{Binding VoltageRailMax, Mode=TwoWay}"/>
                    </StackPanel>
                    <Button Style="{StaticResource Gate}" HorizontalAlignment="Right" Margin="0,3,0,0"
                            Command="{Binding ToggleLeverCommand}" CommandParameter="Nvvdd"
                            Content="{Binding XocArmed, Converter={StaticResource GateLabel}, ConverterParameter=Nvvdd}"
                            ToolTip="Write this rail range to the card now, or put it back"/>
                </StackPanel>

                <!-- MSVDD rail: floor and ceiling on one track -->
                <StackPanel Margin="0,2,0,6" Visibility="{Binding HasMsvddRail, Converter={StaticResource BoolToVis}}">
                    <StackPanel IsEnabled="{Binding XocArmed, Converter={StaticResource Armed}, ConverterParameter=Msvdd}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="MSVDD Range (mV)" Style="{StaticResource RowLabel}"/>
                            <TextBox Grid.Column="1" Style="{StaticResource ValueBox}" Width="46" Margin="0,0,4,0"
                                     ToolTip="{Binding MsvddRailMaxRangeText}"
                                     Text="{Binding MsvddRailFloorInput, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                            <TextBox Grid.Column="2" Style="{StaticResource ValueBox}" Width="46"
                                     ToolTip="{Binding MsvddRailMaxRangeText}"
                                     Text="{Binding MsvddRailMaxInput, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                        </Grid>
                        <c:RangeSlider Margin="0,2,0,0"
                                       Minimum="{Binding Caps.MsvddRailFloorMinMv}" Maximum="{Binding Caps.MsvddRailMaxMv}" Step="5"
                                       LowerValue="{Binding MsvddRailFloor, Mode=TwoWay}"
                                       UpperValue="{Binding MsvddRailMax, Mode=TwoWay}"/>
                    </StackPanel>
                    <Button Style="{StaticResource Gate}" HorizontalAlignment="Right" Margin="0,3,0,0"
                            Command="{Binding ToggleLeverCommand}" CommandParameter="Msvdd"
                            Content="{Binding XocArmed, Converter={StaticResource GateLabel}, ConverterParameter=Msvdd}"
                            ToolTip="Write this rail range to the card now, or put it back"/>
                </StackPanel>

                <!-- OCP current limits. Its own private family, not part of the rail controls above:
                     this is the current at which the card protects itself, not a voltage. -->
                <StackPanel Margin="0,2,0,6" Visibility="{Binding HasOcp, Converter={StaticResource BoolToVis}}">
                    <StackPanel IsEnabled="{Binding XocArmed, Converter={StaticResource Armed}, ConverterParameter=NvvddOcp}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="NVVDD OCP Limit (A)" Style="{StaticResource RowLabel}"/>
                            <TextBox Grid.Column="1" Style="{StaticResource ValueBox}"
                                     ToolTip="{Binding NvvddOcpRangeText}"
                                     Text="{Binding NvvddOcpAmpsInput, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                        </Grid>
                        <Grid Margin="0,1,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <RepeatButton Style="{StaticResource Nudge}" Content="&#9664;" Margin="0,0,4,0"
                                          Command="{Binding NudgeCommand}" CommandParameter="nvocp:-1"/>
                            <Slider Grid.Column="1" Style="{StaticResource Tight}" Minimum="{Binding NvvddOcpMinA}" Maximum="{Binding NvvddOcpMaxA}"
                                    Value="{Binding NvvddOcpAmps, Mode=TwoWay}" TickFrequency="5"/>
                            <RepeatButton Grid.Column="2" Style="{StaticResource Nudge}" Content="&#9654;" Margin="4,0,0,0"
                                          Command="{Binding NudgeCommand}" CommandParameter="nvocp:1"/>
                        </Grid>
                    </StackPanel>
                    <Button Style="{StaticResource Gate}" HorizontalAlignment="Right" Margin="0,3,0,0"
                            Command="{Binding ToggleLeverCommand}" CommandParameter="NvvddOcp"
                            Content="{Binding XocArmed, Converter={StaticResource GateLabel}, ConverterParameter=NvvddOcp}"
                            ToolTip="Write this current limit to the card now, or put it back"/>
                </StackPanel>

                <StackPanel Margin="0,2,0,6" Visibility="{Binding HasOcp, Converter={StaticResource BoolToVis}}">
                    <StackPanel IsEnabled="{Binding XocArmed, Converter={StaticResource Armed}, ConverterParameter=MsvddOcp}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="MSVDD OCP Limit (A)" Style="{StaticResource RowLabel}"/>
                            <TextBox Grid.Column="1" Style="{StaticResource ValueBox}"
                                     ToolTip="{Binding MsvddOcpRangeText}"
                                     Text="{Binding MsvddOcpAmpsInput, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                        </Grid>
                        <Grid Margin="0,1,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <RepeatButton Style="{StaticResource Nudge}" Content="&#9664;" Margin="0,0,4,0"
                                          Command="{Binding NudgeCommand}" CommandParameter="msocp:-1"/>
                            <Slider Grid.Column="1" Style="{StaticResource Tight}" Minimum="{Binding MsvddOcpMinA}" Maximum="{Binding MsvddOcpMaxA}"
                                    Value="{Binding MsvddOcpAmps, Mode=TwoWay}" TickFrequency="5"/>
                            <RepeatButton Grid.Column="2" Style="{StaticResource Nudge}" Content="&#9654;" Margin="4,0,0,0"
                                          Command="{Binding NudgeCommand}" CommandParameter="msocp:1"/>
                        </Grid>
                    </StackPanel>
                    <Button Style="{StaticResource Gate}" HorizontalAlignment="Right" Margin="0,3,0,0"
                            Command="{Binding ToggleLeverCommand}" CommandParameter="MsvddOcp"
                            Content="{Binding XocArmed, Converter={StaticResource GateLabel}, ConverterParameter=MsvddOcp}"
                            ToolTip="Write this current limit to the card now, or put it back"/>
                </StackPanel>

                <!-- Crossbar clock offset - private domain, not in PStates20 -->
                <StackPanel Margin="0,2,0,6" Visibility="{Binding HasXbar, Converter={StaticResource BoolToVis}}">
                    <StackPanel IsEnabled="{Binding XocArmed, Converter={StaticResource Armed}, ConverterParameter=Xbar}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="XBAR Clock (MHz offset)" Style="{StaticResource RowLabel}"/>
                            <TextBox Grid.Column="1" Style="{StaticResource ValueBox}"
                                     ToolTip="{Binding XbarOffsetRangeText}"
                                     Text="{Binding XbarOffsetInput, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                        </Grid>
                        <Grid Margin="0,1,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <RepeatButton Style="{StaticResource Nudge}" Content="&#9664;" Margin="0,0,4,0"
                                          Command="{Binding NudgeCommand}" CommandParameter="xbar:-1"/>
                            <Slider Grid.Column="1" Style="{StaticResource Tight}" Minimum="{Binding Caps.XbarOffsetMinMhz}" Maximum="{Binding Caps.XbarOffsetMaxMhz}"
                                    Value="{Binding XbarOffset, Mode=TwoWay}" TickFrequency="15"/>
                            <RepeatButton Grid.Column="2" Style="{StaticResource Nudge}" Content="&#9654;" Margin="4,0,0,0"
                                          Command="{Binding NudgeCommand}" CommandParameter="xbar:1"/>
                        </Grid>
                    </StackPanel>
                    <Button Style="{StaticResource Gate}" HorizontalAlignment="Right" Margin="0,3,0,0"
                            Command="{Binding ToggleLeverCommand}" CommandParameter="Xbar"
                            Content="{Binding XocArmed, Converter={StaticResource GateLabel}, ConverterParameter=Xbar}"
                            ToolTip="Write this offset to the card now, or put it back"/>
                </StackPanel>

                <!-- SYS clock offset -->
                <StackPanel Margin="0,2,0,6" Visibility="{Binding HasSys, Converter={StaticResource BoolToVis}}">
                    <StackPanel IsEnabled="{Binding XocArmed, Converter={StaticResource Armed}, ConverterParameter=Sys}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="SYS Clock (MHz offset)" Style="{StaticResource RowLabel}"/>
                            <TextBox Grid.Column="1" Style="{StaticResource ValueBox}"
                                     ToolTip="{Binding SysOffsetRangeText}"
                                     Text="{Binding SysOffsetInput, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                        </Grid>
                        <Grid Margin="0,1,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <RepeatButton Style="{StaticResource Nudge}" Content="&#9664;" Margin="0,0,4,0"
                                          Command="{Binding NudgeCommand}" CommandParameter="sys:-1"/>
                            <Slider Grid.Column="1" Style="{StaticResource Tight}" Minimum="{Binding Caps.SysOffsetMinMhz}" Maximum="{Binding Caps.SysOffsetMaxMhz}"
                                    Value="{Binding SysOffset, Mode=TwoWay}" TickFrequency="15"/>
                            <RepeatButton Grid.Column="2" Style="{StaticResource Nudge}" Content="&#9654;" Margin="4,0,0,0"
                                          Command="{Binding NudgeCommand}" CommandParameter="sys:1"/>
                        </Grid>
                    </StackPanel>
                    <Button Style="{StaticResource Gate}" HorizontalAlignment="Right" Margin="0,3,0,0"
                            Command="{Binding ToggleLeverCommand}" CommandParameter="Sys"
                            Content="{Binding XocArmed, Converter={StaticResource GateLabel}, ConverterParameter=Sys}"
                            ToolTip="Write this offset to the card now, or put it back"/>
                </StackPanel>

                <!-- Video clock offset -->
                <StackPanel Margin="0,2,0,6" Visibility="{Binding HasVideo, Converter={StaticResource BoolToVis}}">
                    <StackPanel IsEnabled="{Binding XocArmed, Converter={StaticResource Armed}, ConverterParameter=Video}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Video Clock (MHz offset)" Style="{StaticResource RowLabel}"/>
                            <TextBox Grid.Column="1" Style="{StaticResource ValueBox}"
                                     ToolTip="{Binding VideoOffsetRangeText}"
                                     Text="{Binding VideoOffsetInput, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                        </Grid>
                        <Grid Margin="0,1,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <RepeatButton Style="{StaticResource Nudge}" Content="&#9664;" Margin="0,0,4,0"
                                          Command="{Binding NudgeCommand}" CommandParameter="video:-1"/>
                            <Slider Grid.Column="1" Style="{StaticResource Tight}" Minimum="{Binding Caps.VideoOffsetMinMhz}" Maximum="{Binding Caps.VideoOffsetMaxMhz}"
                                    Value="{Binding VideoOffset, Mode=TwoWay}" TickFrequency="15"/>
                            <RepeatButton Grid.Column="2" Style="{StaticResource Nudge}" Content="&#9654;" Margin="4,0,0,0"
                                          Command="{Binding NudgeCommand}" CommandParameter="video:1"/>
                        </Grid>
                    </StackPanel>
                    <Button Style="{StaticResource Gate}" HorizontalAlignment="Right" Margin="0,3,0,0"
                            Command="{Binding ToggleLeverCommand}" CommandParameter="Video"
                            Content="{Binding XocArmed, Converter={StaticResource GateLabel}, ConverterParameter=Video}"
                            ToolTip="Write this offset to the card now, or put it back"/>
                </StackPanel>

                <!-- Clock range. The one lever here that can only hold the card down rather than push
                     it up, but it gets the same button pair so the window works one way throughout. -->
                <StackPanel Margin="0,2,0,0" Visibility="{Binding HasClockLock, Converter={StaticResource BoolToVis}}">
                    <StackPanel IsEnabled="{Binding XocArmed, Converter={StaticResource Armed}, ConverterParameter=ClockRange}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Clock Range (MHz)" Style="{StaticResource RowLabel}"/>
                            <TextBox Grid.Column="1" Style="{StaticResource ValueBox}" Width="46" Margin="0,0,4,0"
                                     ToolTip="{Binding ClockLockRangeText}"
                                     Text="{Binding ClockLockMinInput, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                            <TextBox Grid.Column="2" Style="{StaticResource ValueBox}" Width="46"
                                     ToolTip="{Binding ClockLockRangeText}"
                                     Text="{Binding ClockLockMaxInput, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                        </Grid>
                        <c:RangeSlider Margin="0,2,0,0"
                                       Minimum="{Binding Caps.ClockLockMinMhz}" Maximum="{Binding Caps.ClockLockMaxMhz}" Step="15"
                                       LowerValue="{Binding ClockLockMin, Mode=TwoWay}"
                                       UpperValue="{Binding ClockLockMax, Mode=TwoWay}"/>
                    </StackPanel>
                    <Button Style="{StaticResource Gate}" HorizontalAlignment="Right" Margin="0,3,0,0"
                            Command="{Binding ToggleLeverCommand}" CommandParameter="ClockRange"
                            Content="{Binding XocArmed, Converter={StaticResource GateLabel}, ConverterParameter=ClockRange}"
                            ToolTip="Pin the graphics clock inside this window now, or put it back"/>
                </StackPanel>

            </StackPanel>
        </Border>
    </DockPanel>
</Window>
