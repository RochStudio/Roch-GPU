<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Product>ROCH GPU</Product>
    <Version>1.0.0</Version>
    <InformationalVersion>1.0.0</InformationalVersion>
    <Copyright>Copyright (c) 2026</Copyright>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms> <!-- only for the tray NotifyIcon -->
    <Nullable>enable</Nullable>
    <!-- Disabled on purpose: with UseWindowsForms=true the SDK would inject global usings for
         System.Windows.Forms and System.Drawing, making Application/MessageBox/Point/Color/Brushes/
         MouseEventArgs/Cursors ambiguous with the WPF types. Every file lists its usings explicitly. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>RochGPU</AssemblyName>
    <StartupObject>GpuTuner.App.EntryPoint</StartupObject>
    <RootNamespace>GpuTuner.App</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\RochGPU.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- One file, no runtime to install. WPF needs the native bits unpacked at start, which is what
         IncludeNativeLibrariesForSelfExtract does; without it the single file refuses to launch. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- lets `dotnet build` work on non-Windows CI boxes (needs the WindowsDesktop ref pack from NuGet) -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Deliberately no GC tuning here. ConcurrentGarbageCollection=false, ServerGarbageCollection
         =false and EventSourceSupport=false were all measured on a fresh start and moved the idle
         footprint by under 2 MB, inside run-to-run noise: the ~60 MB is WPF, not the GC. Don't add
         them back without a measurement showing otherwise. -->

    <!-- Symbols inside the exe rather than beside it: one file to ship, and the crash log
         still names a line. -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <!-- App.xaml is a Page, not an ApplicationDefinition: the SDK would otherwise generate its own
         Main and there would be nowhere to decide between the window and the command line. -->
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\GpuTuner.Core\GpuTuner.Core.csproj" />
    <ProjectReference Include="..\GpuTuner.Cli\GpuTuner.Cli.csproj" />
    <!-- ApplicationIcon covers the exe and the title bar, but the tray needs an Icon object at
         runtime, so the same file is embedded and loaded at the shell's small-icon size. -->
    <EmbeddedResource Include="..\..\assets\RochGPU.ico" LogicalName="RochGPU.ico" />
  </ItemGroup>
</Project>
