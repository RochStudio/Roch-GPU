<Window x:Class="GpuTuner.App.MonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:GpuTuner.App.Controls"
        xmlns:conv="clr-namespace:GpuTuner.App.Converters"
        Title="Roch GPU — Hardware Monitor" Height="730" Width="640" MinWidth="460" MinHeight="360"
        WindowStartupLocation="Manual"
        Style="{StaticResource {x:Type Window}}">
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <DockPanel Margin="8">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Panel}" Padding="12,10">
            <DockPanel>
                <Grid DockPanel.Dock="Top">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="HARDWARE MONITOR" Style="{StaticResource SectionTitle}"/>
                </Grid>

                <!-- Every sensor with its running figures, the way a monitoring tool shows them:
                     four columns, grouped, and each group folds away. -->
                <Grid x:Name="TableFooter" DockPanel.Dock="Bottom" Margin="0,6,10,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="Elapsed" Text="Running 00:00:00" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <CheckBox x:Name="AutoOpen" Content="Auto-open" Click="AutoOpen_Click" VerticalAlignment="Center"
                                  Margin="0,0,12,0" Foreground="{DynamicResource MutedBrush}"
                                  ToolTip="Open this window automatically at launch. It is the only thing that polls the driver, so leaving it off costs nothing until you open it."/>
                        <Button Content="Reset stats" Click="ResetStats_Click" Padding="10,3"/>
                    </StackPanel>
                </Grid>

                <Grid>
                <ScrollViewer x:Name="TableScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,10,0">
                        <ItemsControl x:Name="TableRows" HorizontalContentAlignment="Stretch">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="band" Padding="0,1"
                                            Background="Transparent"
                                           >
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="170"/><ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="nm" Text="{Binding Name}" FontSize="11.5" Margin="4,0,0,0" Foreground="{DynamicResource TextBrush}"/>
                                            <TextBlock x:Name="cur" Grid.Column="1" Text="{Binding Current}" FontSize="11.5" Margin="6,0,6,0" Foreground="{DynamicResource AccentBrush}"/>
                                            <TextBlock x:Name="mn" Grid.Column="2" Text="{Binding Minimum}" FontSize="11.5" Margin="6,0,6,0" Foreground="{DynamicResource MutedBrush}"/>
                                            <TextBlock x:Name="mx" Grid.Column="3" Text="{Binding Maximum}" FontSize="11.5" Margin="6,0,6,0" Foreground="{DynamicResource MutedBrush}"/>
                                            <TextBlock x:Name="av" Grid.Column="4" Text="{Binding Average}" FontSize="11.5" Margin="6,0,6,0" Foreground="{DynamicResource MutedBrush}"/>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsBanded}" Value="True">
                                            <Setter TargetName="band" Property="Background" Value="{DynamicResource PanelAltBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsColumnHeader}" Value="True">
                                            <Setter TargetName="band" Property="Background" Value="Transparent"/>
                                            <Setter TargetName="nm" Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                            <Setter TargetName="cur" Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                            <Setter TargetName="mn" Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                            <Setter TargetName="mx" Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                            <Setter TargetName="av" Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                            <Setter TargetName="band" Property="Background" Value="{DynamicResource PanelAltBrush}"/>
                                            <Setter TargetName="nm" Property="FontWeight" Value="SemiBold"/>
                                            <Setter TargetName="nm" Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                            <Setter TargetName="band" Property="Margin" Value="0,4,0,0"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                </Grid>
            </DockPanel>
        </Border>

        <!-- Fan curve editor: only when the fan mode is Curve -->
        <Border Grid.Row="1" Style="{StaticResource Panel}" Padding="12,10" Margin="0,10,0,0" Height="230"
                Visibility="{Binding IsCurveFan, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="FAN CURVE" Style="{StaticResource SectionTitle}" Margin="0"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="Hysteresis" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="HystBox" Width="36" Text="3" TextChanged="CurveParam_Changed"/>
                        <TextBlock Text="°C   Min step" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="6,0,6,0"/>
                        <TextBox x:Name="StepBox" Width="36" Text="2" TextChanged="CurveParam_Changed"/>
                        <TextBlock Text="%" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="4,0,12,0"/>
                        <Button Content="Default curve" Click="DefaultCurve_Click" Padding="8,3"/>
                    </StackPanel>
                </Grid>
                <c:FanCurveEditor x:Name="CurveEditor"/>
            </DockPanel>
        </Border>
    </Grid>
    </DockPanel>
</Window>
