<Window x:Class="GpuTuner.App.MonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:GpuTuner.App.Controls"
        xmlns:conv="clr-namespace:GpuTuner.App.Converters"
        Title="Roch GPU — Telemetry" Height="900" Width="800" MinWidth="740" MinHeight="480"
        WindowStartupLocation="Manual" FontFamily="Segoe UI"
        Style="{StaticResource {x:Type Window}}">
    <Window.Resources>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="17"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent" Margin="5,0,3,0">
                            <Track x:Name="PART_Track" IsDirectionReversed="True"
                                   Orientation="{TemplateBinding Orientation}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="grip" Background="{DynamicResource MutedBrush}" CornerRadius="4" Opacity="0.3"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="grip" Property="Opacity" Value="0.65"/></Trigger>
                                                    <Trigger Property="IsDragging" Value="True"><Setter TargetName="grip" Property="Opacity" Value="0.8"/></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MetricCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,12"/>
        </Style>
        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>
        <Style x:Key="ColumnLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Margin" Value="8,0"/>
        </Style>
        <Style x:Key="Reading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0"/>
        </Style>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Roch Viewer's telemetry uses a switch here rather than a check box, 32 by 16 with the
             track filling when it is on. Its "on" colour is the neutral #343434, not the brand red -
             a setting that costs an extra poll is not something to advertise. -->
        <Style x:Key="Switch" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="track" Width="32" Height="16" CornerRadius="8"
                                    Background="{DynamicResource BorderBrush}"
                                    BorderBrush="{DynamicResource MutedBrush}" BorderThickness="1">
                                <Ellipse x:Name="knob" Width="12" Height="12" Fill="{DynamicResource MutedBrush}"
                                         HorizontalAlignment="Left" Margin="1,0,0,0"/>
                            </Border>
                            <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="{DynamicResource TitleHoverBrush}"/>
                                <Setter TargetName="knob" Property="Fill" Value="{DynamicResource TextBrush}"/>
                                <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="knob" Property="Margin" Value="0,0,1,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="20,16,20,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Telemetry" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                <TextBlock Text="{Binding DeviceDisplayName}" FontSize="12" Margin="0,4,0,0" Foreground="{DynamicResource MutedBrush}"/>
            </StackPanel>
            <Border HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="5" Background="{DynamicResource PanelBrush}" Padding="10,6">
                <TextBlock Text="LIVE · READ ONLY" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"/>
            </Border>
        </Grid>
        <Grid Grid.Row="1" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource MetricCard}">
                <StackPanel>
                    <TextBlock Text="GPU TEMPERATURE" Style="{StaticResource MetricLabel}"/>
                    <TextBlock x:Name="TemperatureSummary" Text="—" Style="{StaticResource MetricValue}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource MetricCard}">
                <StackPanel>
                    <TextBlock Text="CORE CLOCK" Style="{StaticResource MetricLabel}"/>
                    <TextBlock x:Name="ClockSummary" Text="—" Style="{StaticResource MetricValue}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource MetricCard}">
                <StackPanel>
                    <TextBlock Text="BOARD POWER" Style="{StaticResource MetricLabel}"/>
                    <TextBlock x:Name="PowerSummary" Text="—" Style="{StaticResource MetricValue}"/>
                </StackPanel>
            </Border>
        </Grid>
        <!-- Fixed heading; gutter matches the always-reserved scrollbar in the body. -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,10">
            <Grid Margin="0,0,17,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230"/><ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Sensor" TextAlignment="Left" Style="{StaticResource ColumnLabel}"/>
                <TextBlock Grid.Column="1" Text="Current" Foreground="{DynamicResource TextBrush}" Style="{StaticResource ColumnLabel}"/>
                <TextBlock Grid.Column="2" Text="Minimum" Style="{StaticResource ColumnLabel}"/>
                <TextBlock Grid.Column="3" Text="Maximum" Style="{StaticResource ColumnLabel}"/>
                <TextBlock Grid.Column="4" Text="Average" Style="{StaticResource ColumnLabel}"/>
            </Grid>
        </Border>
        <ScrollViewer Grid.Row="3" x:Name="TableScroll" VerticalScrollBarVisibility="Visible"
                      HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
            <ItemsControl x:Name="TableRows" HorizontalContentAlignment="Stretch">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="band" Padding="0,6" Background="Transparent" CornerRadius="3">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="230"/><ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="nm" Text="{Binding Name}" ToolTip="{Binding Name}"
                                           FontSize="13" Margin="8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock x:Name="cur" Grid.Column="1" Text="{Binding Current}" Style="{StaticResource Reading}"
                                           Foreground="{DynamicResource BrandBrush}" FontWeight="SemiBold"/>
                                <TextBlock x:Name="mn" Grid.Column="2" Text="{Binding Minimum}" Style="{StaticResource Reading}"/>
                                <TextBlock x:Name="mx" Grid.Column="3" Text="{Binding Maximum}" Style="{StaticResource Reading}"/>
                                <TextBlock x:Name="av" Grid.Column="4" Text="{Binding Average}" Style="{StaticResource Reading}"/>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsBanded}" Value="True">
                                <Setter TargetName="band" Property="Background" Value="{DynamicResource HighlightBrush}"/>
                            </DataTrigger>
                            <Trigger SourceName="band" Property="IsMouseOver" Value="True">
                                <Setter TargetName="band" Property="Background" Value="{DynamicResource PanelBrush}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                <Setter TargetName="band" Property="Margin" Value="0,14,0,5"/>
                                <Setter TargetName="band" Property="Padding" Value="0,2"/>
                                <Setter TargetName="band" Property="BorderBrush" Value="{DynamicResource BrandBrush}"/>
                                <Setter TargetName="band" Property="BorderThickness" Value="2,0,0,0"/>
                                <Setter TargetName="nm" Property="FontWeight" Value="SemiBold"/>
                                <Setter TargetName="nm" Property="FontSize" Value="11"/>
                                <Setter TargetName="nm" Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                <Setter TargetName="nm" Property="Grid.ColumnSpan" Value="5"/>
                                <Setter TargetName="cur" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="mn" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="mx" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="av" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <Border Grid.Row="4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="Elapsed" Text="Waiting for sensors…" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ToggleButton x:Name="AutoOpen" Content="Open at launch" Click="AutoOpen_Click" Style="{StaticResource Switch}"
                                  Margin="0,0,16,0" FontSize="11" Foreground="{DynamicResource MutedBrush}"
                                  ToolTip="Open telemetry automatically when Roch GPU starts."/>
                    <Button Content="Reset statistics" Click="ResetStats_Click" Padding="12,6" FontSize="11"
                            ToolTip="Clear minimum, maximum and average values. GPU settings are not changed."/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
