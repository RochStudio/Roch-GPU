<Window x:Class="GpuTuner.App.MonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:GpuTuner.App.Controls"
        xmlns:conv="clr-namespace:GpuTuner.App.Converters"
        Title="Roch GPU — Hardware Monitor" Height="730" Width="640" MinWidth="460" MinHeight="360"
        WindowStartupLocation="Manual"
        Style="{StaticResource {x:Type Window}}">
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <DockPanel Margin="8">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Panel}" Padding="12,10">
            <DockPanel>
                <Grid DockPanel.Dock="Top">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="HARDWARE MONITOR" Style="{StaticResource SectionTitle}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <RadioButton x:Name="ViewGraphs" Content="Graphs" IsChecked="True" GroupName="MonView"
                                     Checked="View_Changed" Margin="0,0,10,0" Foreground="{StaticResource MutedBrush}"/>
                        <RadioButton x:Name="ViewTable" Content="Telemetry" GroupName="MonView"
                                     Checked="View_Changed" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                </Grid>

                <!-- Every sensor with its running figures, the way a monitoring tool shows them:
                     four columns, grouped, and each group folds away. -->
                <Grid x:Name="TableFooter" DockPanel.Dock="Bottom" Margin="0,6,10,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="Elapsed" Text="Running 00:00:00" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="Reset stats" Click="ResetStats_Click" Padding="10,3"/>
                </Grid>

                <Grid>
                <ScrollViewer x:Name="TableScroll" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,10,0">
                        <ItemsControl x:Name="TableRows" HorizontalContentAlignment="Stretch">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="band" Padding="0,1"
                                            Background="Transparent"
                                           >
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="170"/><ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="nm" Text="{Binding Name}" FontSize="11.5" Margin="4,0,0,0" Foreground="{StaticResource TextBrush}"/>
                                            <TextBlock x:Name="cur" Grid.Column="1" Text="{Binding Current}" FontSize="11.5" Margin="6,0,6,0" Foreground="{StaticResource AccentBrush}"/>
                                            <TextBlock x:Name="mn" Grid.Column="2" Text="{Binding Minimum}" FontSize="11.5" Margin="6,0,6,0" Foreground="{StaticResource MutedBrush}"/>
                                            <TextBlock x:Name="mx" Grid.Column="3" Text="{Binding Maximum}" FontSize="11.5" Margin="6,0,6,0" Foreground="{StaticResource MutedBrush}"/>
                                            <TextBlock x:Name="av" Grid.Column="4" Text="{Binding Average}" FontSize="11.5" Margin="6,0,6,0" Foreground="{StaticResource MutedBrush}"/>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsBanded}" Value="True">
                                            <Setter TargetName="band" Property="Background" Value="{StaticResource PanelAltBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsColumnHeader}" Value="True">
                                            <Setter TargetName="band" Property="Background" Value="Transparent"/>
                                            <Setter TargetName="nm" Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                            <Setter TargetName="cur" Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                            <Setter TargetName="mn" Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                            <Setter TargetName="mx" Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                            <Setter TargetName="av" Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                            <Setter TargetName="band" Property="Background" Value="{StaticResource PanelAltBrush}"/>
                                            <Setter TargetName="nm" Property="FontWeight" Value="SemiBold"/>
                                            <Setter TargetName="nm" Property="Foreground" Value="{StaticResource TextBrush}"/>
                                            <Setter TargetName="band" Property="Margin" Value="0,4,0,0"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- How long these figures cover, and a way to start them again: a maximum from an
                     hour ago says nothing about the run happening now. -->

                <ScrollViewer x:Name="GraphScroll" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="GraphStack" Margin="0,0,10,0">

                        <!-- Each row: title + live value on top, graph under. -->
                        <Grid Margin="0,0,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="TCore" Text="Core clock, MHz" Style="{StaticResource GraphTitle}"/>
                            <TextBlock x:Name="VCore" Grid.Column="1" Text="—" Style="{StaticResource GraphValue}" Foreground="{StaticResource CoreBrush}"/>
                        </Grid>
                        <c:LineGraph x:Name="GCore" Height="72" Stroke="{StaticResource CoreBrush}" AutoScale="True" MinSpan="400"/>

                        <Grid Margin="0,7,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Core voltage, mV" Style="{StaticResource GraphTitle}"/>
                            <TextBlock x:Name="VVolt" Grid.Column="1" Text="—" Style="{StaticResource GraphValue}" Foreground="{StaticResource VoltBrush}"/>
                        </Grid>
                        <c:LineGraph x:Name="GVolt" Height="72" Stroke="{StaticResource VoltBrush}" AutoScale="True" MinSpan="150"/>

                        <Grid Margin="0,7,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="TPower" Text="Power, % TDP" Style="{StaticResource GraphTitle}"/>
                            <TextBlock x:Name="VPower" Grid.Column="1" Text="—" Style="{StaticResource GraphValue}" Foreground="{StaticResource PowerBrush}"/>
                        </Grid>
                        <c:LineGraph x:Name="GPower" Height="72" Stroke="{StaticResource PowerBrush}" Minimum="0" Maximum="120" Unit="%"/>
                        <!-- Vendors that report watts instead of % TDP retitle this graph and switch it
                             to auto-scale at runtime; see MainWindow.OnTelemetry. -->

                        <Grid Margin="0,7,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="TTemp" Text="GPU temperature, °C" Style="{StaticResource GraphTitle}"/>
                            <TextBlock x:Name="VTemp" Grid.Column="1" Text="—" Style="{StaticResource GraphValue}" Foreground="{StaticResource TempBrush}"/>
                        </Grid>
                        <c:LineGraph x:Name="GTemp" Height="72" Stroke="{StaticResource TempBrush}" Minimum="20" Maximum="100" Unit="°"/>

                        <Grid Margin="0,7,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="GPU usage, %" Style="{StaticResource GraphTitle}"/>
                            <TextBlock x:Name="VLoad" Grid.Column="1" Text="—" Style="{StaticResource GraphValue}" Foreground="{StaticResource LoadBrush}"/>
                        </Grid>
                        <c:LineGraph x:Name="GLoad" Height="72" Stroke="{StaticResource LoadBrush}" Minimum="0" Maximum="100" Unit="%"/>

                        <Grid Margin="0,7,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Memory clock, MHz" Style="{StaticResource GraphTitle}"/>
                            <TextBlock x:Name="VMem" Grid.Column="1" Text="—" Style="{StaticResource GraphValue}" Foreground="{StaticResource MemBrush}"/>
                        </Grid>
                        <c:LineGraph x:Name="GMem" Height="72" Stroke="{StaticResource MemBrush}" AutoScale="True" MinSpan="600"/>

                        <Grid Margin="0,7,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="TFan" Text="Fan speed, %" Style="{StaticResource GraphTitle}"/>
                            <TextBlock x:Name="VFan" Grid.Column="1" Text="—" Style="{StaticResource GraphValue}" Foreground="{StaticResource FanBrush}"/>
                        </Grid>
                        <c:LineGraph x:Name="GFan" Height="72" Stroke="{StaticResource FanBrush}" Minimum="0" Maximum="100" Unit="%"/>
                    </StackPanel>
                </ScrollViewer>
                </Grid>
            </DockPanel>
        </Border>

        <!-- Fan curve editor: only when the fan mode is Curve -->
        <Border Grid.Row="1" Style="{StaticResource Panel}" Padding="12,10" Margin="0,10,0,0" Height="230"
                Visibility="{Binding IsCurveFan, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="FAN CURVE" Style="{StaticResource SectionTitle}" Margin="0"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="Hysteresis" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="HystBox" Width="36" Text="3" TextChanged="CurveParam_Changed"/>
                        <TextBlock Text="°C   Min step" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="6,0,6,0"/>
                        <TextBox x:Name="StepBox" Width="36" Text="2" TextChanged="CurveParam_Changed"/>
                        <TextBlock Text="%" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="4,0,12,0"/>
                        <Button Content="Default curve" Click="DefaultCurve_Click" Padding="8,3"/>
                    </StackPanel>
                </Grid>
                <c:FanCurveEditor x:Name="CurveEditor"/>
            </DockPanel>
        </Border>
    </Grid>
    </DockPanel>
</Window>
