<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Product>ROCH GPU</Product>
    <Version>1.0.0</Version>
    <InformationalVersion>1.0.0</InformationalVersion>
    <Copyright>Copyright (c) 2026</Copyright>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GpuTuner.Cli</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Symbols inside the exe rather than beside it: one file to ship, and the crash log
         still names a line. -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\GpuTuner.Core\GpuTuner.Core.csproj" />
  </ItemGroup>
</Project>
