<Project Sdk="Microsoft.NET.Sdk">
  <!-- Vendored from https://github.com/falahati/NvAPIWrapper (LGPL-3.0). Trimmed csproj: net8.0 only, no MSBump. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>0.8.1.101</Version>
    <Authors>Soroush Falahati</Authors>
    <Product>NvAPIWrapper.Net</Product>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);CS1591;CS0618;CS1573;CS1572</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Symbols inside the exe rather than beside it: one file to ship, and the crash log
         still names a line. -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="GpuTuner.Core" />
  </ItemGroup>
</Project>
